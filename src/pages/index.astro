	<body class="w-full mx-auto max-w-3xl">
		<div class="flex flex-col basis-0 items-center h-fit w-full mx-auto max-w-3xl py-16">
      <h1 class="sm:text-5xl text-3xl font-mono font-[700]">readylayerone_</h1>
			<h2 class="sm:text-4xl text-2xl font-mono font-[100]">Software Engineer</h2>
