---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono" rel="stylesheet" />
		<title>{title} | readylayerone_</title>
	</head>
	<body class="w-full mx-auto max-w-3xl min-h-screen">
		<nav class="border-b-[0.5px] border-gray-500">
			<div class="px-2 flex flex-row py-2 place-content-between">
				<div class="flex flex-row items-center">
					<div class="w-8 sm:w-12">
						<a href="/"><img src="/smbgen3.png" alt="Home" /></a>
					</div>
					<div class="pl-2 sm:pl-4">
						<a href="/"><h1 class="text-sm sm:text-base font-mono font-[700]">readylayerone_</h1></a>
					</div>
				</div>
				<div class="flex flex-row items-center">
					<a href="/about" class="px-2 text-xs sm:text-sm font-mono underline underline-offset-2">about</a>
					<a href="/now" class="pr-1 text-xs sm:text-sm font-mono underline underline-offset-2">now</a>
				</div>
			</div>
		</nav>
		<main class="px-8 pt-16 pb-16 font-mono text-md markdown-content">
			<slot />
		</main>
	</body>
</html>

<style>
	.markdown-content :global(h1) {
		font-size: 1.5rem;
		font-weight: 100;
		padding-bottom: 2rem;
	}

	.markdown-content :global(h2) {
		font-size: 1.5rem;
		font-weight: 700;
		padding: 1rem 0 1.5rem;
	}

	.markdown-content :global(h4) {
		font-size: 1.125rem;
		font-weight: 700;
		padding-bottom: 0.75rem;
	}

	.markdown-content :global(p) {
		padding-bottom: 1.75rem;
	}

	.markdown-content :global(a) {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.markdown-content :global(.project-link) {
		display: block;
		width: 100%;
		margin: 0 auto 1.75rem;
		overflow: hidden;
		border: 1px solid rgb(209 213 219);
		border-radius: 0.75rem;
		text-decoration: none;
		transition: border-color 150ms ease, transform 150ms ease;
	}

	.markdown-content :global(.project-link:hover) {
		border-color: rgb(107 114 128);
		transform: translateY(-2px);
	}

	.markdown-content :global(.project-link img) {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		background: rgb(243 244 246);
	}

	.markdown-content :global(.project-link span) {
		display: block;
		overflow: hidden;
		padding: 0.75rem 1rem;
		font-size: 0.75rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (min-width: 640px) {
		.markdown-content :global(.project-link) {
			width: 66.6667%;
		}

		.markdown-content :global(h1) {
			font-size: 2.25rem;
		}
	}
</style>
