---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono" rel="stylesheet" />
		<title>{title} | readylayerone_</title>
	</head>
	<body class="w-full mx-auto max-w-3xl min-h-screen">
		<nav class="border-b-[0.5px] border-gray-500">
			<div class="px-2 flex flex-row py-2 place-content-between">
				<div class="flex flex-row items-center">
					<div class="w-8 sm:w-12">
						<a href="/"><img src="/smbgen3.png" alt="Home" /></a>
					</div>
					<div class="pl-2 sm:pl-4">
						<a href="/"><h1 class="text-sm sm:text-base font-mono font-[700]">readylayerone_</h1></a>
					</div>
				</div>
				<div class="flex flex-row items-center">
					<a href="/about" class="px-2 text-xs sm:text-sm font-mono underline underline-offset-2">about</a>
					<a href="/now" class="pr-1 text-xs sm:text-sm font-mono underline underline-offset-2">now</a>
				</div>
			</div>
		</nav>
		<main class="px-8 pt-16 font-mono text-md markdown-content">
			<slot />
		</main>
	</body>
</html>

<style>
	.markdown-content :global(h1) {
		font-size: 1.5rem;
		font-weight: 100;
		padding-bottom: 2rem;
	}

	.markdown-content :global(p) {
		padding-bottom: 1.75rem;
	}

	.markdown-content :global(a) {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (min-width: 640px) {
		.markdown-content :global(h1) {
			font-size: 2.25rem;
		}
	}
</style>
