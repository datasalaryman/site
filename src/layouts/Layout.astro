---
import SiteHead from "../components/SiteHead.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead title={title} />
	</head>
	<body class="w-full mx-auto max-w-3xl">
		<div class="flex flex-col">
			<header>
				<div class="h-fit w-full mx-auto max-w-3xl">
					<div class="text-center py-16">
          	<div class="text-5xl font-mono font-[700]">readylayerone</div>
						<p class="text-4xl font-mono font-[100]">Software Engineer</p>
        	</div>
				</div>
			</header>
			<slot />
		</div>
	</body>
</html>
